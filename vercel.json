{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/medicos/",
      "destination": "/medicos",
      "permanent": true
    },
    {
      "source": "/mercado-digital/",
      "destination": "/mercado-digital",
      "permanent": true
    },
    {
      "source": "/dentistas",
      "destination": "/dentistas/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/assets/images/:path*",
      "destination": "https://digital7-mercado-digital.vercel.app/assets/images/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://digital7-medicos.vercel.app/assets/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "https://digital7-mercado-digital.vercel.app/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "https://digital7-mercado-digital.vercel.app/js/:path*"
    },
    {
      "source": "/medicos",
      "destination": "https://digital7-medicos.vercel.app/"
    },
    {
      "source": "/medicos/:path*",
      "destination": "https://digital7-medicos.vercel.app/:path*"
    },
    {
      "source": "/mercado-digital",
      "destination": "https://digital7-mercado-digital.vercel.app/"
    },
    {
      "source": "/mercado-digital/:path*",
      "destination": "https://digital7-mercado-digital.vercel.app/:path*"
    },
    {
      "source": "/dentistas/",
      "destination": "https://digital7-dentistas.vercel.app/"
    },
    {
      "source": "/dentistas/:path*",
      "destination": "https://digital7-dentistas.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/medicos/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/mercado-digital/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/dentistas/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/css/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/js/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}